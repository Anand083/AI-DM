# Copy to .env on the server and fill in. This file is read by docker-compose.prod.yml.
# Never commit the real .env.

# Where people open the app. No trailing slash.
#   With no domain yet:   https://1-2-3-4.sslip.io   (use your server's address with dashes)
#   Local test:           http://localhost
APP_URL=http://localhost
APP_NAME="SEO Platform"

# What Caddy listens for. Same host as APP_URL without the scheme.
#   ":80" for plain HTTP, "1-2-3-4.sslip.io" or "app.example.com" for HTTPS
SITE_ADDRESS=:80
ACME_EMAIL=you@example.com
# true when APP_URL starts with https
COOKIE_SECURE=false

# Secrets: make each one with   openssl rand -hex 32
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
MOCK_BILLING_WEBHOOK_SECRET=
DATAFORSEO_CALLBACK_SECRET=

# Demo mode: fake search data and fake payments. Never use with real customer data.
SEO_PROVIDER=mock
ALLOW_MOCK_IN_PROD=true
BILLING_PROVIDER=mock

# Email. "mailpit" is a test mailbox (start with --profile testing). Replace with real email later.
EMAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM="SEO Platform <no-reply@localhost>"
# Test mailbox login (only the "testing" profile). Make the hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your password'
MAILPIT_USER=mail
MAILPIT_PASSWORD_HASH=
# Where the test mailbox listens on the server. Keep it on 127.0.0.1 and use an SSH tunnel.
MAILPIT_PORT=127.0.0.1:8025

# Which version of the images to run (a git SHA when deployed by the pipeline)
IMAGE_TAG=latest
CUSTOM_DOMAINS_ENABLED=false
MONTHLY_PROVIDER_BUDGET_USD=50

# Off-server backups. The worker copies the newest nightly dump to this bucket (folder backups/).
# On EC2 use an instance role that may write to the bucket (set the metadata hop limit to 2 so
# containers can reach it). Leave empty to keep backups on the server only.
S3_BUCKET=
AWS_REGION=

# AI text for report summaries and review replies. "mock" uses fixed sentences (no cost).
# With "openrouter" a language model writes them; if it fails, the fixed sentences are used.
SUMMARY_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Google Search Console and Analytics. "mock" shows sample numbers (needs ALLOW_MOCK_IN_PROD=true).
# For real data follow docs/GOOGLE-SETUP.md, then use GOOGLE_PROVIDER=google with the client id and secret.
GOOGLE_PROVIDER=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
