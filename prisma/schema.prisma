generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AgencyStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum InviteRole {
  ADMIN
  MEMBER
  CLIENT
}

enum ClientStatus {
  ACTIVE
  ARCHIVED
}

enum Device {
  DESKTOP
  MOBILE
}

enum RankCheckFrequency {
  DAILY
  WEEKLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingInterval {
  MONTH
  YEAR
}

enum BillingProvider {
  MOCK
  STRIPE
  RAZORPAY
}

// ---------------------------------------------------------------------------
// Auth (Better Auth tables) and users. Not tenant-owned.
// ---------------------------------------------------------------------------

model User {
  id               String   @id @default(cuid(2))
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  image            String?
  isSuperAdmin     Boolean  @default(false)
  timezone         String   @default("UTC")
  /// Set by the two factor plugin once an authenticator app is confirmed.
  twoFactorEnabled Boolean? @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships AgencyMember[]
  clientUsers ClientUser[]
  twoFactors  TwoFactor[]
}

model Session {
  id        String   @id @default(cuid(2))
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid(2))
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid(2))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Tenancy. Every model below except Agency has a required, indexed agencyId.
// ---------------------------------------------------------------------------

model Agency {
  id        String       @id @default(cuid(2))
  name      String
  slug      String       @unique
  timezone  String       @default("UTC")
  status    AgencyStatus @default(ACTIVE)
  deletedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  /// Alert settings. A keyword that was in the top `alertDropWithin` and fell by `alertDropPositions` or more gives an alert.
  alertDropPositions   Int       @default(5)
  alertDropWithin      Int       @default(20)
  /// A keyword that moves into the top `alertTopPosition` gives an alert.
  alertTopPosition     Int       @default(10)
  alertOnCriticalAudit Boolean   @default(true)
  /// Email a summary of new alerts to owners and admins every morning (agency time).
  dailyDigest          Boolean   @default(false)
  lastDigestOn         DateTime? @db.Date

  members            AgencyMember[]
  invitations        Invitation[]
  clients            Client[]
  clientUsers        ClientUser[]
  projects           Project[]
  subscription       Subscription?
  activityLogs       ActivityLog[]
  usageRecords       UsageRecord[]
  providerTasks      PendingProviderTask[]
  keywords           Keyword[]
  rankChecks         RankCheck[]
  audits             Audit[]
  backlinks          Backlink[]
  competitors        Competitor[]
  competitorKeywords CompetitorKeyword[]
  aiPrompts          AiPrompt[]
  aiChecks           AiVisibilityCheck[]
  localBusinesses    LocalBusiness[]
  reviewSnapshots    ReviewSnapshot[]
  reviews            Review[]
  googleConnections  GoogleConnection[]
  searchConsoleDays  SearchConsoleDay[]
  ga4Days            Ga4Day[]
  aiSettings         AiSetting[]
  backlinkSnapshots  BacklinkSnapshot[]
  keywordLists       KeywordList[]
  alerts             Alert[]
  branding           Branding?
  reports            Report[]
  dataExports        DataExport[]
  impersonations     Impersonation[]
  usageBonuses       UsageBonus[]
  invoices           Invoice[]
  checkoutSessions   CheckoutSession[]
  billingEvents      BillingEvent[]
  reportSchedules    ReportSchedule[]
  keywordListItems   KeywordListItem[]
  auditPages         AuditPage[]
  auditIssues        AuditIssue[]
  leads              Lead[]
  tasks              Task[]
  taskComments       TaskComment[]
  milestones         Milestone[]
  taskTemplates      TaskTemplate[]
  reportComments     ReportComment[]
  reportTemplates    ReportTemplate[]
  annotations        Annotation[]
  goals              Goal[]
  goalPoints         GoalPoint[]
  searchBreakdowns   SearchBreakdown[]
  ga4Pages           Ga4Page[]

  @@index([status, deletedAt])
}

model AgencyMember {
  id        String     @id @default(cuid(2))
  agencyId  String
  userId    String
  role      MemberRole
  createdAt DateTime   @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, userId])
  @@index([userId])
}

model Invitation {
  id          String     @id @default(cuid(2))
  agencyId    String
  email       String
  role        InviteRole
  clientId    String?
  tokenHash   String     @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  createdAt   DateTime   @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, email])
  @@index([agencyId, createdAt])
}

model Client {
  id           String       @id @default(cuid(2))
  agencyId     String
  name         String
  website      String?
  contactName  String?
  contactEmail String?
  notes        String?
  status       ClientStatus @default(ACTIVE)
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  agency      Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  projects    Project[]
  clientUsers ClientUser[]

  @@index([agencyId, status, deletedAt])
  @@index([agencyId, name])
}

model ClientUser {
  id        String   @id @default(cuid(2))
  agencyId  String
  clientId  String
  userId    String
  createdAt DateTime @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@index([agencyId])
  @@index([userId])
}

model Project {
  id                 String             @id @default(cuid(2))
  agencyId           String
  clientId           String
  name               String
  domain             String
  locationCode       Int
  languageCode       String
  device             Device             @default(DESKTOP)
  rankCheckFrequency RankCheckFrequency @default(DAILY)
  rankCheckHourUtc   Int                @default(3)
  /// Run a site audit on its own once a month.
  autoAudit          Boolean            @default(false)
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  agency             Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client             Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  keywords           Keyword[]
  audits             Audit[]
  backlinks          Backlink[]
  competitors        Competitor[]
  competitorKeywords CompetitorKeyword[]
  aiPrompts          AiPrompt[]
  aiChecks           AiVisibilityCheck[]
  localBusinesses    LocalBusiness[]
  reviewSnapshots    ReviewSnapshot[]
  reviews            Review[]
  googleConnections  GoogleConnection[]
  tasks              Task[]
  milestones         Milestone[]
  annotations        Annotation[]
  goals              Goal[]
  searchConsoleDays  SearchConsoleDay[]
  ga4Days            Ga4Day[]
  aiSettings         AiSetting[]
  backlinkSnapshots  BacklinkSnapshot[]
  reports            Report[]
  reportSchedule     ReportSchedule?
  searchBreakdowns   SearchBreakdown[]
  ga4Pages           Ga4Page[]

  @@index([agencyId, clientId, deletedAt])
  @@index([agencyId, domain])
}

// ---------------------------------------------------------------------------
// Plans and subscriptions
// ---------------------------------------------------------------------------

model Plan {
  id                String   @id @default(cuid(2))
  code              String   @unique
  name              String
  currency          String   @default("USD")
  priceMonthlyCents Int
  priceYearlyCents  Int
  limits            Json
  isPublic          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                     String             @id @default(cuid(2))
  agencyId               String             @unique
  planId                 String
  status                 SubscriptionStatus
  interval               BillingInterval    @default(MONTH)
  provider               BillingProvider    @default(MOCK)
  providerCustomerId     String?
  providerSubscriptionId String?
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  graceEndsAt            DateTime?
  /// A plan change that starts at the end of the current period (a downgrade).
  pendingPlanId          String?
  pendingInterval        BillingInterval?
  /// Set when the 3 day and 1 day trial reminder emails were queued.
  trialReminder3At       DateTime?
  trialReminder1At       DateTime?
  /// Provider specific notes. The mock provider uses `{ "failRenewal": true }` in tests.
  providerMeta           Json?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([status, currentPeriodEnd])
}

// ---------------------------------------------------------------------------
// Rank tracking
// ---------------------------------------------------------------------------

/// A phrase tracked for a project. The `current*`, `best*` and `change*` columns are a snapshot
/// of the latest rank checks, kept so tables can sort and filter in the database.
model Keyword {
  id        String   @id @default(cuid(2))
  agencyId  String
  projectId String
  phrase    String
  tags      String[]
  targetUrl String?
  createdAt DateTime @default(now())

  /// Day of the latest rank check. Null means never checked.
  lastCheckedOn   DateTime? @db.Date
  /// Latest position, 1 to 100. Null with `lastCheckedOn` set means "not in the top 100".
  currentPosition Int?
  currentUrl      String?
  currentFeatures String[]
  bestPosition    Int?
  /// Change since about 1, 7 and 30 days ago. Positive means better. Null when there is nothing to compare.
  changeDay       Int?
  changeWeek      Int?
  changeMonth     Int?

  agency     Agency      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rankChecks RankCheck[]

  @@unique([projectId, phrase])
  @@index([agencyId, projectId, phrase])
  @@index([agencyId, projectId, currentPosition])
  @@index([agencyId, projectId, changeWeek])
}

/// One result per keyword per day. `position` null means not in the top 100.
model RankCheck {
  id           String   @id @default(cuid(2))
  agencyId     String
  keywordId    String
  date         DateTime @db.Date
  checkedAt    DateTime @default(now())
  position     Int?
  rankingUrl   String?
  serpFeatures Json?
  topResults   Json?
  provider     String

  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  keyword Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([keywordId, date])
  @@index([agencyId, date])
}

// ---------------------------------------------------------------------------
// White label
// ---------------------------------------------------------------------------

enum ScheduleFrequency {
  WEEKLY
  MONTHLY
}

enum ReportStatus {
  QUEUED
  GENERATING
  READY
  FAILED
}

enum CustomDomainStatus {
  NONE
  PENDING
  VERIFIED
  FAILED
}

/// How an agency looks to its clients: name, logo, colours, contact details.
model Branding {
  id                 String             @id @default(cuid(2))
  agencyId           String             @unique
  displayName        String
  /// Storage key of the logo file, or null.
  logoKey            String?
  logoContentType    String?
  primaryColor       String             @default("#18181b")
  accentColor        String             @default("#2563eb")
  supportEmail       String?
  website            String?
  customDomain       String?            @unique
  customDomainStatus CustomDomainStatus @default(NONE)
  domainVerifyToken  String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Alerts
// ---------------------------------------------------------------------------

enum AlertType {
  RANK_DROP
  RANK_GAIN
  AUDIT_CRITICAL
  BACKLINKS_LOST
  AI_MENTION_LOST
  NEW_REVIEW
  TASK_DUE
  CLIENT_RESPONSE
  GOOGLE_ANOMALY
  GOOGLE_RECONNECT
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

/// Something worth a look. One alert summarises a whole run (for example all keywords that
/// dropped today in a project), so a big move does not flood the bell.
model Alert {
  id        String        @id @default(cuid(2))
  agencyId  String
  projectId String?
  type      AlertType
  severity  AlertSeverity
  title     String
  body      String
  data      Json?
  /// Stops the same alert being created twice (for example "rank_drop:<project>:<date>").
  dedupeKey String
  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime      @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([agencyId, dedupeKey])
  @@index([agencyId, readAt, createdAt])
  @@index([agencyId, projectId, readAt])
  @@index([agencyId, emailedAt, createdAt])
}

// ---------------------------------------------------------------------------
// Keyword research
// ---------------------------------------------------------------------------

/// A saved set of researched keywords.
model KeywordList {
  id          String   @id @default(cuid(2))
  agencyId    String
  name        String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agency Agency            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  items  KeywordListItem[]

  @@unique([agencyId, name])
}

model KeywordListItem {
  id           String   @id @default(cuid(2))
  agencyId     String
  listId       String
  phrase       String
  volume       Int
  /// Cost per click in micro-dollars.
  cpcMicros    Int
  difficulty   Int
  intent       String
  locationCode Int
  languageCode String
  createdAt    DateTime @default(now())

  agency Agency      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  list   KeywordList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, phrase])
  @@index([agencyId, listId, createdAt])
}

// ---------------------------------------------------------------------------
// Site audits
// ---------------------------------------------------------------------------

enum AuditStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum IssueSeverity {
  CRITICAL
  WARNING
  NOTICE
}

model Audit {
  id             String      @id @default(cuid(2))
  agencyId       String
  projectId      String
  status         AuditStatus @default(QUEUED)
  providerTaskId String?
  /// 0 to 100 while running.
  progress       Int         @default(0)
  maxPages       Int
  pagesCrawled   Int         @default(0)
  /// 0 to 100, set when the audit completes.
  healthScore    Int?
  /// { critical, warning, notice, byCode: { code: count } }
  counts         Json?
  requestedById  String?
  startedAt      DateTime?
  finishedAt     DateTime?
  error          String?
  createdAt      DateTime    @default(now())

  agency  Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pages   AuditPage[]
  issues  AuditIssue[]

  @@index([agencyId, projectId, createdAt])
  @@index([status, createdAt])
}

model AuditPage {
  id         String  @id @default(cuid(2))
  agencyId   String
  auditId    String
  url        String
  statusCode Int
  title      String?
  loadTimeMs Int
  wordCount  Int
  issueCount Int

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  audit  Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([agencyId, auditId, issueCount])
}

model AuditIssue {
  id       String        @id @default(cuid(2))
  agencyId String
  auditId  String
  code     String
  severity IssueSeverity
  url      String
  details  Json?

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  audit  Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([agencyId, auditId, code])
  @@index([agencyId, auditId, severity])
}

// ---------------------------------------------------------------------------
// Provider usage and cache
// ---------------------------------------------------------------------------

enum UsageMetric {
  RANK_CHECK
  LIVE_CHECK
  AUDIT_PAGE
  KEYWORD_RESEARCH
  BACKLINK_QUERY
  COMPETITOR_QUERY
  AI_CHECK
  REVIEW_QUERY
  LEAD_AUDIT
}

/// One row per paid (or mock) provider call. `costMicros` is in micro-dollars (1,000,000 = $1).
model UsageRecord {
  id          String      @id @default(cuid(2))
  agencyId    String
  projectId   String?
  metric      UsageMetric
  quantity    Int
  costMicros  Int
  provider    String
  operation   String
  requestHash String?
  createdAt   DateTime    @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, metric, createdAt])
  @@index([createdAt])
}

enum ProviderTaskStatus {
  PENDING
  READY
  PROCESSED
  FAILED
}

/// A job we sent to a provider that finishes later (for example a DataForSEO task).
/// `tag` carries our own job id so we can match the provider's callback to our work.
model PendingProviderTask {
  id             String             @id @default(cuid(2))
  agencyId       String
  projectId      String?
  provider       String
  operation      String
  providerTaskId String             @unique
  tag            String
  requestHash    String?
  status         ProviderTaskStatus @default(PENDING)
  attempts       Int                @default(0)
  /// Result sent by a postback, or fetched later. Null until then.
  result         Json?
  error          String?
  createdAt      DateTime           @default(now())
  readyAt        DateTime?
  processedAt    DateTime?

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([agencyId])
}

/// Shared cache of provider answers. SEO data is public, so it is shared between agencies.
model ProviderCache {
  id          String   @id @default(cuid(2))
  provider    String
  operation   String
  requestHash String   @unique
  response    Json
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Platform
// ---------------------------------------------------------------------------

model ActivityLog {
  id                 String   @id @default(cuid(2))
  agencyId           String
  actorUserId        String?
  impersonatorUserId String?
  action             String
  targetType         String?
  targetId           String?
  metadata           Json?
  ip                 String?
  createdAt          DateTime @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, createdAt])
  @@index([agencyId, action])
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Reports
// ---------------------------------------------------------------------------

model Report {
  id             String       @id @default(cuid(2))
  agencyId       String
  projectId      String
  title          String
  status         ReportStatus @default(QUEUED)
  /// YYYY-MM-DD in the agency time zone.
  periodStart    DateTime     @db.Date
  periodEnd      DateTime     @db.Date
  /// Section keys, for example ["summary", "distribution"].
  sections       String[]
  notes          String?
  /// The finished report data (the typed report model). Set when the report is ready.
  data           Json?
  /// Storage key of the PDF, and its size.
  pdfKey         String?
  pdfBytes       Int?
  error          String?
  /// Random token for the public share link. Null when sharing is off.
  shareToken     String?      @unique
  shareExpiresAt DateTime?
  createdById    String?
  generatedAt    DateTime?
  createdAt      DateTime     @default(now())
  /// Set when a schedule made this report. `scheduledFor` is the run time it was made for.
  scheduleId     String?
  scheduledFor   DateTime?
  /// Set once the emails for a scheduled report were queued, so they are never sent twice.
  deliveredAt    DateTime?

  agency   Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments ReportComment[]

  @@unique([scheduleId, scheduledFor])
  @@index([agencyId, createdAt])
  @@index([agencyId, projectId, createdAt])
}

model ReportSchedule {
  id         String            @id @default(cuid(2))
  agencyId   String
  projectId  String            @unique
  frequency  ScheduleFrequency
  /// 1 (Monday) to 7 (Sunday). Used when weekly.
  dayOfWeek  Int               @default(1)
  /// 1 to 28. Used when monthly.
  dayOfMonth Int               @default(1)
  /// 0 to 23 in the agency time zone.
  hour       Int               @default(8)
  recipients String[]
  sections   String[]
  enabled    Boolean           @default(true)
  /// Next run time (UTC). The dispatcher picks schedules whose time has passed.
  nextRunAt  DateTime
  lastRunAt  DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([enabled, nextRunAt])
  @@index([agencyId, createdAt])
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  PAID
  FAILED
}

enum CheckoutStatus {
  OPEN
  COMPLETED
  FAILED
}

/// Every webhook we receive, once. The event id is unique, so a repeat is ignored.
model BillingEvent {
  id          String          @id @default(cuid(2))
  eventId     String          @unique
  provider    BillingProvider
  type        String
  agencyId    String?
  payload     Json
  receivedAt  DateTime        @default(now())
  processedAt DateTime?
  error       String?

  agency Agency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)

  @@index([agencyId, receivedAt])
}

model Invoice {
  id          String        @id @default(cuid(2))
  agencyId    String
  /// Human friendly number, for example INV-000012.
  number      String        @unique
  description String
  amountCents Int
  currency    String        @default("USD")
  status      InvoiceStatus
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime      @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, createdAt])
}

/// Used by the mock billing provider: a checkout the person finishes on our own page.
model CheckoutSession {
  id        String          @id @default(cuid(2))
  agencyId  String
  planCode  String
  interval  BillingInterval
  status    CheckoutStatus  @default(OPEN)
  createdAt DateTime        @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, createdAt])
}

// ---------------------------------------------------------------------------
// Super admin
// ---------------------------------------------------------------------------

/// A super admin looking at an agency as one of its members. Ends after 30 minutes.
model Impersonation {
  id           String    @id @default(cuid(2))
  adminUserId  String
  targetUserId String
  agencyId     String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  endedAt      DateTime?

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([adminUserId, createdAt])
  @@index([agencyId, createdAt])
}

/// Extra units of a usage metric given to an agency for the month it was created in.
model UsageBonus {
  id        String      @id @default(cuid(2))
  agencyId  String
  metric    UsageMetric
  quantity  Int
  note      String?
  createdBy String?
  createdAt DateTime    @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, metric, createdAt])
}

/// Authenticator app secret and backup codes (written by the Better Auth two factor plugin).
model TwoFactor {
  id                      String    @id @default(cuid(2))
  userId                  String
  secret                  String
  backupCodes             String
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
}

enum ExportStatus {
  QUEUED
  READY
  FAILED
}

/// A zip with all of an agency's data, made in the worker for the owner to download.
model DataExport {
  id            String       @id @default(cuid(2))
  agencyId      String
  status        ExportStatus @default(QUEUED)
  storageKey    String?
  bytes         Int?
  error         String?
  requestedById String?
  createdAt     DateTime     @default(now())
  readyAt       DateTime?
  expiresAt     DateTime

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, createdAt])
  @@index([expiresAt])
}

/// A message sent from the public contact form. Not tied to any agency.
model ContactMessage {
  id        String   @id @default(cuid(2))
  name      String
  email     String
  message   String
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Backlinks
// ---------------------------------------------------------------------------

/// One link from another site to a project's website. A link that disappears is kept with `lostAt`.
model Backlink {
  id                String    @id @default(cuid(2))
  agencyId          String
  projectId         String
  sourceUrl         String
  sourceDomain      String
  targetUrl         String
  anchor            String
  dofollow          Boolean
  /// 0 to 100, the authority of the linking site.
  sourceRating      Int
  /// UTC days (no time).
  firstSeen         DateTime  @db.Date
  lastSeen          DateTime  @db.Date
  lostAt            DateTime? @db.Date
  suspicious        Boolean   @default(false)
  /// Why the link was flagged: "spammy_tld", "low_rating", "exact_anchor".
  suspiciousReasons String[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sourceUrl, targetUrl])
  @@index([agencyId, projectId, lostAt, firstSeen])
  @@index([agencyId, projectId, suspicious])
}

/// The numbers from one weekly check of a project's backlinks.
model BacklinkSnapshot {
  id               String   @id @default(cuid(2))
  agencyId         String
  projectId        String
  /// UTC day of the check.
  takenOn          DateTime @db.Date
  totalBacklinks   Int
  referringDomains Int
  dofollowPercent  Int
  domainRating     Int
  /// Links found for the first time / links that disappeared since the snapshot before.
  newLinks         Int
  lostLinks        Int
  createdAt        DateTime @default(now())

  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, takenOn])
  @@index([agencyId, projectId, takenOn])
}

// ---------------------------------------------------------------------------
// Competitors
// ---------------------------------------------------------------------------

/// A website a project is compared with. At most 5 per project (see MAX_COMPETITORS in the service).
model Competitor {
  id           String    @id @default(cuid(2))
  agencyId     String
  projectId    String
  /// Lower case, without "www." and without a path.
  domain       String
  createdAt    DateTime  @default(now())
  /// When the keyword gap list for this competitor was last refreshed.
  gapFetchedAt DateTime?

  agency   Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project  Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  keywords CompetitorKeyword[]

  @@unique([projectId, domain])
  @@index([agencyId, projectId])
}

/// A keyword a competitor ranks for that the project does not rank for or track (the keyword gap).
/// The list for a competitor is replaced on every refresh.
model CompetitorKeyword {
  id           String   @id @default(cuid(2))
  agencyId     String
  projectId    String
  competitorId String
  keyword      String
  /// The competitor's position, 1 to 100.
  position     Int
  volume       Int
  url          String?
  createdAt    DateTime @default(now())

  agency     Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, keyword])
  @@index([agencyId, projectId, volume])
  @@index([agencyId, competitorId, volume])
}

// ---------------------------------------------------------------------------
// AI visibility
// ---------------------------------------------------------------------------

/// A question people might ask an AI assistant, for example "best dentist in Austin".
model AiPrompt {
  id        String   @id @default(cuid(2))
  agencyId  String
  projectId String
  text      String
  createdAt DateTime @default(now())

  agency  Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checks  AiVisibilityCheck[]

  @@unique([projectId, text])
  @@index([agencyId, projectId])
}

/// Which brand name and which AI engines are used for a project's checks. One row per project.
model AiSetting {
  id        String   @id @default(cuid(2))
  agencyId  String
  projectId String
  brandName String
  /// Engine keys, for example "chatgpt", "gemini", "perplexity", "claude", "google_ai_overview".
  engines   String[]
  updatedAt DateTime @updatedAt

  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId])
  @@index([agencyId])
}

/// The answer of one AI engine to one prompt on one day.
model AiVisibilityCheck {
  id                   String   @id @default(cuid(2))
  agencyId             String
  projectId            String
  promptId             String
  engine               String
  /// UTC day of the check.
  checkedOn            DateTime @db.Date
  brandMentioned       Boolean
  domainCited          Boolean
  /// Place of the brand among the brands named in the answer (1 is first).
  mentionPosition      Int?
  sentiment            String?
  snippet              String
  citedUrls            String[]
  /// Competitors of the project that the answer names or links to.
  competitorsMentioned String[]
  provider             String
  createdAt            DateTime @default(now())

  agency  Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  prompt  AiPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, engine, checkedOn])
  @@index([agencyId, projectId, checkedOn])
}

// ---------------------------------------------------------------------------
// Local SEO and reviews
// ---------------------------------------------------------------------------

/// The business a project's review tracking looks up. One per project.
model LocalBusiness {
  id            String    @id @default(cuid(2))
  agencyId      String
  projectId     String
  name          String
  /// Town or city, for people to read. The provider search uses the project's country.
  city          String?
  createdAt     DateTime  @default(now())
  /// UTC day of the last review check.
  lastCheckedOn DateTime? @db.Date

  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId])
  @@index([agencyId])
}

/// The rating and number of reviews on one day. The rating is stored in tenths (43 means 4.3).
model ReviewSnapshot {
  id           String   @id @default(cuid(2))
  agencyId     String
  projectId    String
  takenOn      DateTime @db.Date
  ratingTenths Int
  reviewCount  Int
  newReviews   Int
  createdAt    DateTime @default(now())

  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, takenOn])
  @@index([agencyId, projectId, takenOn])
}

/// One review of the business. `key` identifies it (author, stars and text), so it is saved once.
model Review {
  id             String   @id @default(cuid(2))
  agencyId       String
  projectId      String
  key            String
  author         String
  rating         Int
  text           String
  publishedAt    DateTime @db.Date
  /// UTC day we first saw it.
  firstSeenOn    DateTime @db.Date
  suggestedReply String?
  createdAt      DateTime @default(now())

  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@index([agencyId, projectId, publishedAt])
  @@index([agencyId, projectId, rating, publishedAt])
}

// ---------------------------------------------------------------------------
// Google Search Console and Google Analytics 4
// ---------------------------------------------------------------------------

/// A project's link to a Google account. Tokens are encrypted with ENCRYPTION_KEY before saving.
model GoogleConnection {
  id                  String    @id @default(cuid(2))
  agencyId            String
  projectId           String
  accountEmail        String?
  accessTokenEnc      String
  refreshTokenEnc     String?
  accessExpiresAt     DateTime
  scopes              String[]
  /// The sites and properties the account can see, saved when connecting so choosing needs no Google call.
  availableSites      Json
  availableProperties Json
  gscSite             String?
  ga4PropertyId       String?
  ga4PropertyName     String?
  /// ACTIVE, or NEEDS_RECONNECT when Google no longer accepts the tokens.
  status              String    @default("ACTIVE")
  lastError           String?
  lastSyncedOn        DateTime? @db.Date
  connectedById       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId])
  @@index([agencyId])
}

/// One day of Search Console numbers. Position is in tenths (73 means 7.3).
model SearchConsoleDay {
  id             String   @id @default(cuid(2))
  agencyId       String
  projectId      String
  date           DateTime @db.Date
  clicks         Int
  impressions    Int
  positionTenths Int

  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, date])
  @@index([agencyId, projectId, date])
}

/// One day of Google Analytics 4 numbers.
model Ga4Day {
  id          String   @id @default(cuid(2))
  agencyId    String
  projectId   String
  date        DateTime @db.Date
  sessions    Int
  conversions Int

  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, date])
  @@index([agencyId, projectId, date])
}

// ---------------------------------------------------------------------------
// Lead generation widget
// ---------------------------------------------------------------------------

/// A visitor of an agency's website who asked for a free mini audit through the widget.
model Lead {
  id             String    @id @default(cuid(2))
  agencyId       String
  /// Long random id the widget uses to ask for the result. It is the only thing that finds a lead without signing in.
  publicId       String    @unique @default(cuid(2))
  /// The website the visitor wants checked, without "www." and path.
  domain         String
  email          String
  /// QUEUED, RUNNING, DONE or FAILED.
  status         String    @default("QUEUED")
  providerTaskId String?
  healthScore    Int?
  pagesCrawled   Int?
  /// The most important issues: [{ code, title, severity, fix }].
  issues         Json?
  error          String?
  notifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  finishedAt     DateTime?

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, createdAt])
  @@index([agencyId, domain, email, createdAt])
}

// ---------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------

/// A piece of SEO work for the team. It may come from an audit issue.
model Task {
  id              String    @id @default(cuid(2))
  agencyId        String
  projectId       String?
  title           String
  description     String    @default("")
  /// TODO, IN_PROGRESS, BLOCKED or DONE.
  status          String    @default("TODO")
  /// LOW, MEDIUM, HIGH or URGENT.
  priority        String    @default("MEDIUM")
  /// A member of the agency.
  assigneeId      String?
  dueOn           DateTime? @db.Date
  estimateMinutes Int?
  /// NONE, WEEKLY or MONTHLY. When a repeating task is done, the next one is created.
  recurrence      String    @default("NONE")
  sourceAuditId   String?
  sourceIssueCode String?
  createdById     String?
  completedAt     DateTime?
  /// Client users of the project's client can see this task.
  clientVisible   Boolean   @default(false)
  /// NONE, REQUESTED, APPROVED or CHANGES_REQUESTED.
  approvalStatus  String    @default("NONE")
  approvalNote    String?
  approvalAt      DateTime?
  approvalById    String?
  milestoneId     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  agency   Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project  Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments TaskComment[]

  @@index([agencyId, status, dueOn])
  @@index([agencyId, projectId, status])
  @@index([agencyId, assigneeId, status])
  @@index([agencyId, projectId, sourceIssueCode])
}

model TaskComment {
  id            String   @id @default(cuid(2))
  agencyId      String
  taskId        String
  authorId      String?
  body          String
  /// Shown to client users too. Team comments are private unless this is set.
  clientVisible Boolean  @default(false)
  fromClient    Boolean  @default(false)
  createdAt     DateTime @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([agencyId, taskId, createdAt])
}

/// A goal for a project with a due day. Tasks can be linked to it, and clients see the progress.
model Milestone {
  id            String    @id @default(cuid(2))
  agencyId      String
  projectId     String
  title         String
  dueOn         DateTime? @db.Date
  completedAt   DateTime?
  clientVisible Boolean   @default(true)
  createdAt     DateTime  @default(now())

  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([agencyId, projectId, dueOn])
}

/// A reusable list of tasks. `items` is [{ title, description, priority, days, estimateMinutes }].
model TaskTemplate {
  id        String   @id @default(cuid(2))
  agencyId  String
  name      String
  items     Json
  createdAt DateTime @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([agencyId, name])
}

/// A comment on a report, from the team or from a client user.
model ReportComment {
  id         String   @id @default(cuid(2))
  agencyId   String
  reportId   String
  authorId   String?
  fromClient Boolean  @default(false)
  body       String
  createdAt  DateTime @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([agencyId, reportId, createdAt])
}

// ---------------------------------------------------------------------------
// Reporting extras: templates, annotations, goals
// ---------------------------------------------------------------------------

/// A saved choice of report sections (and notes) for a kind of client.
model ReportTemplate {
  id        String   @id @default(cuid(2))
  agencyId  String
  name      String
  sections  String[]
  notes     String?
  createdAt DateTime @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([agencyId, name])
}

/// A dated note about something that may explain a change: a campaign, an algorithm update, a site change.
model Annotation {
  id          String   @id @default(cuid(2))
  agencyId    String
  /// Empty means it applies to every project (for example a Google update).
  projectId   String?
  on          DateTime @db.Date
  /// CAMPAIGN, ALGORITHM, SITE_CHANGE or OTHER.
  kind        String
  title       String
  createdById String?
  createdAt   DateTime @default(now())

  agency  Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([agencyId, projectId, on])
}

/// A target for a project, for example 20 keywords in the top 10 by a date.
model Goal {
  id         String    @id @default(cuid(2))
  agencyId   String
  projectId  String
  /// TOP10_KEYWORDS, AVG_POSITION, HEALTH_SCORE, CLICKS_28D, SESSIONS_28D or REVIEW_RATING.
  kind       String
  /// In the unit of the kind: keywords, tenths of a position, points, clicks, sessions, tenths of a star.
  target     Int
  startValue Int?
  dueOn      DateTime? @db.Date
  createdAt  DateTime  @default(now())

  agency  Agency      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  points  GoalPoint[]

  @@unique([projectId, kind])
  @@index([agencyId, projectId])
}

/// The value of a goal's number on one day, saved by the worker. Used for progress and forecasts.
model GoalPoint {
  id       String   @id @default(cuid(2))
  agencyId String
  goalId   String
  on       DateTime @db.Date
  value    Int

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, on])
  @@index([agencyId, goalId, on])
}

/// A top list from Search Console for the last 28 days (NOW) or the 28 days before (BEFORE). Replaced on every sync.
model SearchBreakdown {
  id             String @id @default(cuid(2))
  agencyId       String
  projectId      String
  /// QUERY, PAGE, COUNTRY or DEVICE.
  dimension      String
  /// NOW or BEFORE.
  period         String
  key            String
  clicks         Int
  impressions    Int
  positionTenths Int

  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, dimension, period, key])
  @@index([agencyId, projectId, dimension, period, clicks])
}

/// Landing pages from Google Analytics for the last 28 days. Replaced on every sync.
model Ga4Page {
  id              String @id @default(cuid(2))
  agencyId        String
  projectId       String
  path            String
  sessions        Int
  engagedSessions Int
  conversions     Int

  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([agencyId, projectId, sessions])
}
