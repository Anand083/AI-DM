generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AgencyStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum InviteRole {
  ADMIN
  MEMBER
  CLIENT
}

enum ClientStatus {
  ACTIVE
  ARCHIVED
}

enum Device {
  DESKTOP
  MOBILE
}

enum RankCheckFrequency {
  DAILY
  WEEKLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingInterval {
  MONTH
  YEAR
}

enum BillingProvider {
  MOCK
  STRIPE
  RAZORPAY
}

// ---------------------------------------------------------------------------
// Auth (Better Auth tables) and users. Not tenant-owned.
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid(2))
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  isSuperAdmin  Boolean  @default(false)
  timezone      String   @default("UTC")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships AgencyMember[]
  clientUsers ClientUser[]
}

model Session {
  id        String   @id @default(cuid(2))
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid(2))
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid(2))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Tenancy. Every model below except Agency has a required, indexed agencyId.
// ---------------------------------------------------------------------------

model Agency {
  id        String       @id @default(cuid(2))
  name      String
  slug      String       @unique
  timezone  String       @default("UTC")
  status    AgencyStatus @default(ACTIVE)
  deletedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  members      AgencyMember[]
  invitations  Invitation[]
  clients      Client[]
  clientUsers  ClientUser[]
  projects     Project[]
  subscription Subscription?
  activityLogs ActivityLog[]
  usageRecords UsageRecord[]

  @@index([status, deletedAt])
}

model AgencyMember {
  id        String     @id @default(cuid(2))
  agencyId  String
  userId    String
  role      MemberRole
  createdAt DateTime   @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, userId])
  @@index([userId])
}

model Invitation {
  id          String     @id @default(cuid(2))
  agencyId    String
  email       String
  role        InviteRole
  clientId    String?
  tokenHash   String     @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  createdAt   DateTime   @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, email])
  @@index([agencyId, createdAt])
}

model Client {
  id           String       @id @default(cuid(2))
  agencyId     String
  name         String
  website      String?
  contactName  String?
  contactEmail String?
  notes        String?
  status       ClientStatus @default(ACTIVE)
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  agency      Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  projects    Project[]
  clientUsers ClientUser[]

  @@index([agencyId, status, deletedAt])
  @@index([agencyId, name])
}

model ClientUser {
  id        String   @id @default(cuid(2))
  agencyId  String
  clientId  String
  userId    String
  createdAt DateTime @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@index([agencyId])
  @@index([userId])
}

model Project {
  id                 String             @id @default(cuid(2))
  agencyId           String
  clientId           String
  name               String
  domain             String
  locationCode       Int
  languageCode       String
  device             Device             @default(DESKTOP)
  rankCheckFrequency RankCheckFrequency @default(DAILY)
  rankCheckHourUtc   Int                @default(3)
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([agencyId, clientId, deletedAt])
  @@index([agencyId, domain])
}

// ---------------------------------------------------------------------------
// Plans and subscriptions
// ---------------------------------------------------------------------------

model Plan {
  id                String   @id @default(cuid(2))
  code              String   @unique
  name              String
  currency          String   @default("USD")
  priceMonthlyCents Int
  priceYearlyCents  Int
  limits            Json
  isPublic          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                     String             @id @default(cuid(2))
  agencyId               String             @unique
  planId                 String
  status                 SubscriptionStatus
  interval               BillingInterval    @default(MONTH)
  provider               BillingProvider    @default(MOCK)
  providerCustomerId     String?
  providerSubscriptionId String?
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  graceEndsAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([status, currentPeriodEnd])
}

// ---------------------------------------------------------------------------
// Provider usage and cache
// ---------------------------------------------------------------------------

enum UsageMetric {
  RANK_CHECK
  LIVE_CHECK
  AUDIT_PAGE
  KEYWORD_RESEARCH
  BACKLINK_QUERY
  COMPETITOR_QUERY
  AI_CHECK
  REVIEW_QUERY
  LEAD_AUDIT
}

/// One row per paid (or mock) provider call. `costMicros` is in micro-dollars (1,000,000 = $1).
model UsageRecord {
  id          String      @id @default(cuid(2))
  agencyId    String
  projectId   String?
  metric      UsageMetric
  quantity    Int
  costMicros  Int
  provider    String
  operation   String
  requestHash String?
  createdAt   DateTime    @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, metric, createdAt])
  @@index([createdAt])
}

/// Shared cache of provider answers. SEO data is public, so it is shared between agencies.
model ProviderCache {
  id          String   @id @default(cuid(2))
  provider    String
  operation   String
  requestHash String   @unique
  response    Json
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Platform
// ---------------------------------------------------------------------------

model ActivityLog {
  id                 String   @id @default(cuid(2))
  agencyId           String
  actorUserId        String?
  impersonatorUserId String?
  action             String
  targetType         String?
  targetId           String?
  metadata           Json?
  ip                 String?
  createdAt          DateTime @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, createdAt])
  @@index([agencyId, action])
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
